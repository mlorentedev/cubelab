# n8n environment, generated into the `n8n-config` ConfigMap.
#
# This lives in a file rather than inline in `services/n8n.yaml` for the same
# reason `vikunja-config/vikunja.env` does (lesson-404, #1446): a
# `configMapGenerator` appends a content hash to the object name, so editing a
# value here changes the name and rolls the Deployment. n8n reads its
# environment once at container start and re-reads none of it, so as a plain
# ConfigMap consumed through `envFrom` an edit here would leave Argo CD
# reporting Synced/Healthy while the running pod kept the old value forever.
#
# That is not hypothetical for this service. It is exactly how #1705 stayed
# invisible: `multi-forge-sync` failed at its first Code node on every single
# run since the day it was deployed, and the two keys that fix it are below.
#
# Domain values are staging's. Prod merges its own over these via
# `behavior: merge` in `overlays/prod/kustomization.yaml`.

N8N_HOST=n8n.staging.kubelab.live
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.staging.kubelab.live/
N8N_PROXY_HOPS=1
DB_TYPE=sqlite
GENERIC_TIMEZONE=Europe/Madrid
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_MIGRATE_FS_STORAGE_PATH=true

# --- Code node runtime (APP-CONFIG-014, #1705) -------------------------------
#
# n8n has blocked Code-node access to `$env` by default since v20. Our workflows
# read their HMAC webhook secret from `$env`, so with the default in force
# `Parse Forge Event` threw "access to env vars denied" on its first statement
# and the workflow died there -- before the signature check, before routing,
# before the Vikunja lookup. Measured over every rotated event log in prod:
# `multi-forge-sync` had zero successful runs, ever, while the webhook answered
# 200 to Gitea on every delivery including its own crashes.
#
# THE TRADE-OFF, STATED: unblocking this exposes every pod environment variable
# to every Code node, VIKUNJA_API_TOKEN and N8N_ENCRYPTION_KEY included. That is
# acceptable here only because this is a single-operator instance and every
# workflow is committed to this repository and imported from it -- there is no
# path by which an untrusted Code node reaches this process.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# `Parse Forge Event` computes the HMAC with `require('crypto')`, and n8n
# refuses a `require` of any builtin that is not allowlisted. Scoped to the one
# module actually required rather than `*`: this is the second half of #1705,
# and without it unblocking `$env` above only moves the failure two lines down.
# `tests/test_n8n_code_node_runtime_render.py` derives this list from the
# committed workflows, so a new `require` fails the suite until it is declared.
NODE_FUNCTION_ALLOW_BUILTIN=crypto
