# Prod overrides for `n8n-config`, merged over `base/services/n8n-config/n8n.env`.
#
# ONLY the keys that genuinely differ from the base belong here. The Code-node
# runtime flags added for #1705 are deliberately absent: they are identical in
# both environments and inherit through `behavior: merge`. Re-declaring them
# would create a second place for them to drift, and the environment where they
# matter most is this one — prod is where the Gitea webhooks point.

N8N_HOST=n8n.kubelab.live
WEBHOOK_URL=https://n8n.kubelab.live/
N8N_LOG_LEVEL=warn
